# Keep the build context to source only: a smaller context is a faster build,
# and nothing here should ever be baked into an image.
.git
.gitignore
.dockerignore
.idea
bin/
dist/
docs/
deploy/
brand/
README.md
Dockerfile

# The image rebuilds the browser bundle from web/ in its own stage, so the
# committed copy would only be overwritten.
internal/webui/dist/
web/node_modules/
